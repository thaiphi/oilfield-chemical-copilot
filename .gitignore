.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Keep public sample data trackable; keep private corpus local only.
.private/
data/private/*
!data/private/.gitkeep
data/processed/

# Local runtime output
logs/
tmp/
outputs/

.uv-cache/
.pytest-tmp/
pytest-cache-files-*

eval/private/

# Project-local Codex working memory. Durable decisions and aggregate evidence
# belong under docs/, while generated task packets and detailed run logs stay local.
.codex/briefs/*.md
.codex/reports/*.md
.agents/skills/subagent-cache-guard/

# Test-runner scratch directories and locks.
.pytest-*/
.test-tmp-*/
