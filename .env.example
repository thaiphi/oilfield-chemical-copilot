OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=granite4.1:8b
OLLAMA_EMBEDDING_MODEL=granite-embedding:latest
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSION=384
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_MIN_SCORE=0.2
RAG_MAX_CONTEXT_CHARS=4000

POSTGRES_DB=oilfield_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/oilfield_copilot
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oilfield_copilot_test

STREAMLIT_PORT=8501
KESTRA_PORT=8080
GRAFANA_PORT=3000

DATA_MODE=sample
DATA_SAMPLE_PATH=data/sample
DATA_PRIVATE_PATH=data/private
